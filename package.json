{
  "name": "dsh-turn-delete",
  "version": "0.6.0",
  "type": "module",
  "description": "Delete one finished turn from a DeepSeek Harness session without deleting the session: the turn leaves the model context, the log stays intact",
  "license": "MIT",
  "author": "Kingsir111 <Kingsir111@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kingsir111/dsh-turn-delete.git"
  },
  "bugs": {
    "url": "https://github.com/Kingsir111/dsh-turn-delete/issues"
  },
  "homepage": "https://github.com/Kingsir111/dsh-turn-delete#readme",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets",
    "screenshots.json"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test:client": "node test/client-register.mjs",
    "test:gate": "node test/compat-gate.mjs",
    "test:matrix": "node test/matrix.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "turn-delete",
    "context",
    "conversation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  }
}
